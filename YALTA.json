    {
      "parameters": {
        "jsCode": "const inputItem = $json || {};\nconst logType = inputItem.type || 'ssh';\nconst logLine = inputItem.log_line || '';\nconst rulesJson = inputItem.rules || {}; // Правила уже здесь!\n\nconst patterns = rulesJson[logType] || [];\nconst flags = logType === 'journalctl' ? 'i' : '';\n\nconst matchedPattern = patterns.find(pattern => {\n  try {\n    return new RegExp(pattern, flags).test(logLine);\n  } catch (e) {\n    return false;\n  }\n});\n\nreturn {\n  json: {\n    log_line: logLine,\n    log_type: logType,\n    is_suspicious: Boolean(matchedPattern),\n    matched_rule: matchedPattern || null\n  }\n};"
      },
