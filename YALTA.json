        "jsonBody": "={\n  \"model\": \"ibm/granite-3.1-8b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an SOC analyst. Assess whether this activity is suspicious. Just write down your assessment and a list of issues (specifying the relevant lines); do not try to engage in a conversation.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze log: {{ $json.log_line }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
      },
