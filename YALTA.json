{
  "name": "YALTA",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// 1. Проверяем наличие бинарных данных\nconst binaryData = $input.item.binary;\nif (!binaryData || !binaryData.file || !binaryData.rules) {\n  throw new Error(\"Missing 'file' or 'rules' parameter in request.\");\n}\n\n// 2. Читаем файл логов\nconst logBuffer = await this.helpers.getBinaryDataBuffer(0, 'file');\nconst logText = logBuffer.toString('utf-8');\n\n// 3. Читаем файл правил (rules.json)\nconst rulesBuffer = await this.helpers.getBinaryDataBuffer(0, 'rules');\nconst rulesJson = JSON.parse(rulesBuffer.toString('utf-8'));\n\n// 4. Получаем тип лога\nconst body = $('Webhook').item.json.body || {};\nconst logType = body.type || 'ssh';\n\n// 5. Разбиваем лог на строки\nconst lines = logText.split(/\\r?\\n/).filter(line => line.trim() !== '');\n\nif (lines.length === 0) {\n  return [{ json: { log_line: '', type: logType, rules: rulesJson, is_empty: true } }];\n}\n\n// 6. Передаем в следующий узел строку лога, тип и САМИ ПРАВИЛА\nreturn lines.map(line => ({\n  json: {\n    log_line: line,\n    type: logType,\n    rules: rulesJson // Пробрасываем правила как JSON-объект каждому элементу\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        96
      ],
      "id": "3e9fdb6e-e563-44bc-be86-e91b6f19315b",
      "name": "reading file"
    },
